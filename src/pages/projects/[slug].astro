---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, status, category, tech, start_date, github_repo, starter } = project.data;
const statusText = status === 'prototyping' ? 'Prototyping' : status.charAt(0).toUpperCase() + status.slice(1);
---

<BaseLayout title={title} description={summary}>
	<div class="page-shell">
		<header class="page-title">
			<p class="eyebrow">Project file / {category}</p>
			<h1>{title}</h1>
			<p class="lead">{summary}</p>
			{starter && <p class="starter-callout">Illustrative starter record · replace with verified project details</p>}
			<div class="detail-meta">
				<span class:list={['status-label', `status-${status}`]}>{statusText}</span>
				{start_date && <span class="section-count">Started {start_date}</span>}
				{github_repo && <a class="project-link" href={github_repo} target="_blank" rel="noreferrer">Source repository ↗</a>}
				<div class="tag-list">{tech.map((item) => <span class="tag">{item}</span>)}</div>
			</div>
		</header>
		<article class="prose"><Content /></article>
		<a class="back-link" href="/#projects">← Back to projects</a>
	</div>
</BaseLayout>